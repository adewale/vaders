{
  "name": "vaders-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/write-build-info.mjs",
    "dev": "wrangler dev",
    "predeploy": "node ../scripts/write-build-info.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "pretest": "node ../scripts/write-build-info.mjs",
    "test": "vitest run",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.1",
    "@cloudflare/workers-types": "^4.20250124.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.6.0"
  }
}
